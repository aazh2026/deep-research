# CRUX reproduction LLM config
#
# Optional: when these vars are set, an LLM-based grader is used IN ADDITION
# to the lexical F1 proxy on a small sample (V6 in reproduce.py).  When unset,
# the reproduction runs entirely on the lexical F1 proxy (deterministic,
# 0 LLM cost, ~7s runtime for 47 samples).
#
# The endpoint and key below match the environment this project was developed
# in (Claude Code's runtime LLM endpoint).  To use a different provider, set
# the four vars to your own values.

# OpenAI-compatible chat completions endpoint
CRUX_LLM_ENDPOINT=https://api.minimaxi.com/v1

# Bearer token (do not commit a real key; use a placeholder here)
CRUX_LLM_API_KEY=sk-cp-ReplaceWithYourKey

# Model name as expected by the endpoint
CRUX_LLM_MODEL=openai/MiniMax-M3.1-Flash-Preview

# Optional tuning knobs for the LLM-grader sanity check
CRUX_LLM_GRADER_N_SAMPLES=5        # how many (passage, gold_info) pairs to score
CRUX_LLM_GRADER_TIMEOUT_S=30       # per-request timeout
