# LoopsBench reproduction environment
# This reproduction loads the official HF dataset LoopsBench/LoopsBench
# and runs structural verification of paper claims (Section 2.3, Tables 2 & 4).
#
# LLM is NOT used in this round (round 19 structural sanity check).
# The .env file is included for convention only.
# To extend to a full Agent run, fill in real keys.

OPENAI_KEY=sk-cp-...your-key-here...
OPENAI_API_KEY=sk-cp-...your-key-here...
OPENAI_API_BASE_URL=https://api.example.com/v1
OPENAI_API_BASE=https://api.example.com/v1
ANTHROPIC_API_KEY=sk-cp-...your-key-here...
ANTHROPIC_BASE_URL=https://api.example.com/v1

# Optional: Hugging Face token for higher rate limits on dataset download
HF_TOKEN=hf_...your-token-here...
