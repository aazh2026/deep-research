# AEOLLM-2 reproduction environment
# This reproduction is metric-only (3 alignment metrics) with scipy cross-validation.
# No LLM call required for the metric part.
# To extend to a full 91-submission leaderboard, fill in real keys.

OPENAI_KEY=sk-cp-...your-key-here...
OPENAI_API_KEY=sk-cp-...your-key-here...
OPENAI_API_BASE_URL=https://api.example.com/v1
OPENAI_API_BASE=https://api.example.com/v1
ANTHROPIC_API_KEY=sk-cp-...your-key-here...
ANTHROPIC_BASE_URL=https://api.example.com/v1

# Optional: Hugging Face token for AEOLLM-2 dataset (huggingface.co/datasets/THUIR/AEOLLM)
HF_TOKEN=hf_...your-token-here...
