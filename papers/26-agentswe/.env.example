# AgentSWE reproduction -- optional LLM endpoint for V7 sanity check.
# Copy to .env and replace placeholder values to enable V7.
# Used by reproduce.py V7 to ping the LLM endpoint.

AGENTSWE_LLM_ENDPOINT=https://api.minimaxi.com/v1
AGENTSWE_LLM_API_KEY=your-api-key-here
AGENTSWE_LLM_MODEL=openai/MiniMax-M3.1-Flash-Preview
